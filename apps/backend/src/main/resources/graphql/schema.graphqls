type Course {
    id: ID
    name: String
    description:String
    slug: String
    enabled: Boolean
    createdAt: String
    profile: Profile
}

type Profile {
    id: ID,
    name: String
    lastName: String
    avatarUrl: String
    user: User!
}

type User {
    id:ID
    email: String
    role: String
    enabled: Boolean
    lastLogin: String
    createdAt: String
}

type Dashboard {
    userCount: Int!
    courseCount: Int!
    latestProfiles: [Profile!]!
    latestCourses: [Course!]!
}

type ChatMessage {
    id: ID!
    userId: ID!
    topicId: ID!
    question: String
    answer: String
    createdAt: String
}

type Query {
    lastChats: [ChatMessage!]!
    lastCourses:[Course!]!
    courses: [Course!]!
    dashboard: Dashboard!
}